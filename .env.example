# Copy to `.env` on the VPS. Never commit the real password.

NODE_ENV=production
API_PORT=8787
# Docker / Dokploy: 0.0.0.0 so Traefik can reach the container.
# Host nginx + PM2 (HOSTINGER.md): 127.0.0.1
API_HOST=0.0.0.0

# Create a Hostinger mailbox (hPanel → Emails), enable SMTP, then fill these.
# Same domain as the website is better for deliverability.
# Port 465 + SMTP_SECURE=true (SSL), or port 587 + SMTP_SECURE=false (STARTTLS).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Usually the same Hostinger mailbox address as SMTP_USER.
MAIL_FROM=

# Recipients: comma-separated. SMTP login can stay one mailbox;
# MAIL_TO can list several people.
# Example: MAIL_TO=info@clearviewglobal.com,other@clearviewglobal.com
MAIL_TO=info@clearviewglobal.com
MAIL_CC=
MAIL_BCC=

# Web3Forms is unused. The Le Parc form posts to /api/le-parc-inquiry.
